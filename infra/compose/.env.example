# SafeGate Environment Template (.env.example)
# Copy to .env and configure secrets appropriately

# Server Settings
SAFEGATE__SERVER__HOST=0.0.0.0
SAFEGATE__SERVER__PORT=8000
SAFEGATE__SERVER__ENV=development
SAFEGATE__SERVER__DEBUG=true

# Database (PostgreSQL)
SAFEGATE__DATABASE__URL=postgresql+asyncpg://safegate:safegate_dev_secret@localhost:5432/safegate
POSTGRES_DB=safegate
POSTGRES_USER=safegate
POSTGRES_PASSWORD=safegate_dev_secret

# Redis Cache & Queue
SAFEGATE__REDIS__URL=redis://:safegate_dev_redis@localhost:6379/0
REDIS_PASSWORD=safegate_dev_redis

# S3 / MinIO Object Storage
SAFEGATE__STORAGE__ENDPOINT_URL=http://localhost:9000
SAFEGATE__STORAGE__ACCESS_KEY=minioadmin
SAFEGATE__STORAGE__SECRET_KEY=minioadmin123
SAFEGATE__STORAGE__REGION=us-east-1
SAFEGATE__STORAGE__QUARANTINE_BUCKET=safegate-quarantine
SAFEGATE__STORAGE__PUBLISHED_BUCKET=safegate-published
SAFEGATE__STORAGE__SECURE_VAULT_BUCKET=safegate-vault

# Rate Limits & Upload Bounds
SAFEGATE__LIMITS__MAX_FILE_SIZE_BYTES=524288000 # 500 MB
SAFEGATE__LIMITS__MAX_DURATION_SECONDS=300
SAFEGATE__LIMITS__RATE_LIMIT_REQUESTS=100
SAFEGATE__LIMITS__RATE_LIMIT_WINDOW_SECONDS=60

# Policy & Thresholds
SAFEGATE__POLICY__FAIL_CLOSED_MODE=true
SAFEGATE__POLICY__REQUIRE_TEMPORAL_CONFIRMATION=true
SAFEGATE__POLICY__CONFIRMATION_MIN_FRAMES=3

SAFEGATE__THRESHOLDS__DEEPFAKE_MANIPULATION_SCORE__YELLOW_REVIEW=0.35
SAFEGATE__THRESHOLDS__DEEPFAKE_MANIPULATION_SCORE__RED_BLOCK=0.75
SAFEGATE__THRESHOLDS__SENSITIVE_CONTENT_SCORE__YELLOW_REVIEW=0.50
SAFEGATE__THRESHOLDS__UNCERTAINTY_SCORE__YELLOW_REVIEW=0.40

# Child Safety
SAFEGATE__CHILD_SAFETY__ENABLED=true
SAFEGATE__CHILD_SAFETY__MOCK_DETECTION=true

# Tamper-Evident Audit
SAFEGATE__AUDIT__HMAC_SECRET=dev_super_secret_audit_key_32_bytes_min
