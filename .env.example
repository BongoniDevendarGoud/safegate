# =============================================================================
# SafeGate — Environment Configuration (.env.example)
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in real values for your environment.
#   3. NEVER commit .env to version control (it is excluded by .gitignore).
#
# Every secret and configurable threshold lives here so that no sensitive
# values or magic numbers are hardcoded in the application source code.
# =============================================================================

# ---------------------------------------------------------------------------
# API KEYS — used for authentication across client and administrative endpoints
# ---------------------------------------------------------------------------
# ADMIN_API_KEY: Grants access to moderator actions, review queue, and audit logs.
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-strong-random-key

# CLIENT_API_KEY: Key used by client services or uploaders submitting to /api/upload
CLIENT_API_KEY=change-me-to-a-client-key

# ---------------------------------------------------------------------------
# GEMINI AI — second-opinion screening for borderline explicit / deepfake frames
# ---------------------------------------------------------------------------
# Set to "true" to activate Gemini second opinion; "false" to run strictly offline
USE_GEMINI=false

# Google Gemini API Key (only required when USE_GEMINI=true)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model identifier — read dynamically from environment, never hardcoded
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# PIPELINE THRESHOLDS — fail-closed screening boundaries
# ---------------------------------------------------------------------------
# NSFW score >= BLOCK_THRESHOLD  -> automatic BLOCK (range 0.0 - 1.0)
BLOCK_THRESHOLD=0.85

# NSFW score >= REVIEW_THRESHOLD and < BLOCK_THRESHOLD -> REVIEW (borderline)
REVIEW_THRESHOLD=0.45

# Perceptual hash Hamming distance <= threshold -> perceptual match -> BLOCK
PHASH_HAMMING_THRESHOLD=10

# Maximum number of frames extracted per video (bounds CPU and memory usage)
MAX_FRAMES=60

# Frame extraction interval in seconds (e.g. 1 frame every 2 seconds)
FRAME_INTERVAL_SEC=2

# ---------------------------------------------------------------------------
# UPLOAD LIMITS & RATE LIMITING
# ---------------------------------------------------------------------------
# Maximum file size allowed in megabytes
MAX_UPLOAD_SIZE_MB=200

# Maximum uploads per minute per IP address
RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# DEEPFAKE HEURISTICS
# ---------------------------------------------------------------------------
# Combined probabilistic deepfake score (0-100) >= this -> triggers REVIEW
DEEPFAKE_REVIEW_THRESHOLD=60

# ---------------------------------------------------------------------------
# SERVER & CORS SETTINGS
# ---------------------------------------------------------------------------
# Allowed Origin for CORS headers (restricts browser API access)
DASHBOARD_ORIGIN=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# FILE STORAGE & DATABASE
# ---------------------------------------------------------------------------
# Storage folders relative to application root or absolute
QUARANTINE_DIR=quarantine
REVIEW_DIR=review
PUBLISHED_DIR=published

# Database connection string (SQLite file-based database)
DATABASE_URL=sqlite:///safegate.db
